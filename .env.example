# Copy to .env.local for local development. Never commit real values.

# Base URL of the backend API. A path such as /api works with a Next.js rewrite or proxy.
NEXT_PUBLIC_API_URL=/api

# enabled: the browser uses MSW mocks from src/mocks instead of a real backend.
NEXT_PUBLIC_API_MOCKING=enabled

# Sentry (optional). Error tracking stays inactive while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
